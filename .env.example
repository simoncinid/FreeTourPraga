# Production: Railway web + worker + PostgreSQL with daily volume backups.
# For local preview use npm run setup:local; never copy development users to production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:25060/freetourpraga?sslmode=require&connection_limit=5&pool_timeout=15"
PLATFORM_STORAGE="postgres"
# Keep preview true until real content, payments and email have been validated.
SITE_PREVIEW="true"
NEXT_PUBLIC_SITE_URL="https://YOUR-DOMAIN.example"
SESSION_SECRET=""
# Optional separate signing key for booking links; at least 32 random characters.
BOOKING_LINK_SECRET=""
# JSON array: use node scripts/password-hash.mjs with password on stdin.
STAFF_USERS='[{"email":"staff@example.com","role":"admin","passwordHash":"SALT:SCRYPT_HASH"}]'
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TRIPADVISOR_URL=""
NEXT_PUBLIC_TRIPADVISOR_WIDGET_SCRIPT_SRC=""
TRIPADVISOR_WIDGET_HTML=""
SMTP_HOST="mail.freetourpraga.com"
SMTP_PORT="587"
SMTP_USER="info@freetourpraga.com"
SMTP_PASS=""
SMTP_FROM="freetourpraga.com <info@freetourpraga.com>"
# Invio transazionale via HTTPS. Con una chiave configurata, Resend è il provider attivo.
RESEND_API_KEY=""
RESEND_FROM="FreeTourPraga <info@freetourpraga.com>"
ADMIN_EMAIL="info@freetourpraga.com"
# Destinatari mail operativa prenotazioni (CF7 mail 1 / UWT). Virgola-separati.
# In collaudo usare solo una casella di test: non inviare prenotazioni fittizie a UWT.
BOOKING_ADMIN_EMAILS="info@freetourpraga.com,admin@unitedworldtours.eu"
CRON_SECRET=""
# Railway worker only:
PLATFORM_URL="https://YOUR-DOMAIN.example"
# Daily backup job only. AGE_RECIPIENT is the public key; store private key offline.
AGE_RECIPIENT=""
BACKUP_BUCKET=""
SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
# Optional media bucket. With MEDIA_BUCKET unset, images persist in PostgreSQL.
MEDIA_BUCKET=""
MEDIA_PUBLIC_BASE="https://YOUR-MEDIA-BUCKET.fra1.cdn.digitaloceanspaces.com"
MEDIA_ACCESS_KEY_ID=""
MEDIA_SECRET_ACCESS_KEY=""
